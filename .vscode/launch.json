{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "拡張機能の開発ホストを起動",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/app",
        "--disable-extensions"
      ],
      "outFiles": [
        "${workspaceFolder}/app/out/**/*.js"
      ],
      "preLaunchTask": "npm: compile - app"
    }
  ]
}
