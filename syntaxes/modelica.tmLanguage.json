{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Modelica",
  "scopeName": "source.modelica",
  "patterns": [
    { "include": "#comments" },
    { "include": "#within-import" },
    { "include": "#class-definition" },
    { "include": "#function-definition" },
    { "include": "#extends" },
    { "include": "#keywords-control" },
    { "include": "#keywords-sections" },
    { "include": "#keywords-storage" },
    { "include": "#keywords-modifier" },
    { "include": "#keywords-other" },
    { "include": "#constants-language" },
    { "include": "#builtin-types" },
    { "include": "#builtin-functions" },
    { "include": "#numbers" },
    { "include": "#strings" },
    { "include": "#type-reference" },
    { "include": "#function-call" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.modelica",
          "begin": "//",
          "end": "$",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.modelica" }
          }
        },
        {
          "name": "comment.block.modelica",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.begin.modelica" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.comment.end.modelica" }
          }
        }
      ]
    },
    "within-import": {
      "patterns": [
        {
          "match": "^\\s*(within)\\b",
          "captures": {
            "1": { "name": "keyword.control.import.modelica" }
          }
        },
        {
          "match": "\\b(import)\\b",
          "captures": {
            "1": { "name": "keyword.control.import.modelica" }
          }
        }
      ]
    },
    "class-definition": {
      "match": "\\b(model|class|record|block|connector|package|type|enumeration)\\s+((?:'[^']*')|[A-Za-z_$][\\w$]*)",
      "captures": {
        "1": { "name": "storage.type.class.modelica" },
        "2": { "name": "entity.name.type.class.modelica" }
      }
    },
    "function-definition": {
      "match": "\\b(function|operator)\\s+((?:'[^']*')|[A-Za-z_$][\\w$]*)",
      "captures": {
        "1": { "name": "storage.type.function.modelica" },
        "2": { "name": "entity.name.function.modelica" }
      }
    },
    "extends": {
      "match": "\\b(extends|constrainedby)\\b",
      "captures": {
        "1": { "name": "keyword.control.inheritance.modelica" }
      }
    },
    "keywords-control": {
      "name": "keyword.control.modelica",
      "match": "\\b(if|then|else|elseif|elsewhen|when|for|in|loop|while|break|return|end)\\b"
    },
    "keywords-sections": {
      "name": "keyword.other.section.modelica",
      "match": "\\b(equation|algorithm|initial|public|protected|external|annotation)\\b"
    },
    "keywords-storage": {
      "name": "storage.type.modelica",
      "match": "\\b(model|class|record|block|connector|package|type|function|operator|enumeration|pure|impure|expandable)\\b"
    },
    "keywords-modifier": {
      "name": "storage.modifier.modelica",
      "match": "\\b(partial|encapsulated|final|replaceable|redeclare|inner|outer|parameter|constant|discrete|flow|stream|input|output|each)\\b"
    },
    "keywords-other": {
      "name": "keyword.other.modelica",
      "match": "\\b(connect|assert|terminate|reinit|der|delay|cardinality|homotopy|semiLinear|noEvent|smooth|edge|change|pre|sample)\\b"
    },
    "constants-language": {
      "patterns": [
        {
          "name": "constant.language.boolean.modelica",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.modelica",
          "match": "\\b(time|Modelica\\.Constants\\.(?:pi|e|R|N_A|k|h|c|eps|inf))\\b"
        }
      ]
    },
    "builtin-types": {
      "name": "support.type.primitive.modelica",
      "match": "\\b(Real|Integer|Boolean|String|StateSelect|AssertionLevel|ExternalObject)\\b"
    },
    "builtin-functions": {
      "name": "support.function.builtin.modelica",
      "match": "\\b(abs|sign|sqrt|div|mod|rem|ceil|floor|integer|sin|cos|tan|asin|acos|atan|atan2|sinh|cosh|tanh|exp|log|log10|min|max|sum|product|size|ndims|scalar|vector|matrix|transpose|outerProduct|cross|skew|identity|diagonal|zeros|ones|fill|linspace|array|cat|symmetric|initial|terminal|analysisType)\\b"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.modelica",
          "match": "\\b\\d+\\.\\d*(?:[eE][+-]?\\d+)?\\b|\\.\\d+(?:[eE][+-]?\\d+)?\\b|\\b\\d+[eE][+-]?\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.modelica",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.modelica",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.modelica" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.modelica" }
      },
      "patterns": [
        {
          "name": "constant.character.escape.modelica",
          "match": "\\\\(?:[\\\\\"'nrtfabv]|\\d{1,3})"
        }
      ]
    },
    "type-reference": {
      "comment": "ドット付きの大文字始まりパス（Modelica.Units.SI.Temperature など）",
      "match": "\\b([A-Z][\\w$]*)(\\.[A-Za-z_$][\\w$]*)+\\b",
      "name": "entity.name.type.modelica"
    },
    "function-call": {
      "match": "\\b((?:'[^']*')|[A-Za-z_$][\\w$]*)\\s*(?=\\()",
      "name": "entity.name.function.call.modelica"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.modelica",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "keyword.operator.assignment.modelica",
          "match": ":=|="
        },
        {
          "name": "keyword.operator.arithmetic.modelica",
          "match": "\\.[+\\-*/^]|[+\\-*/^]"
        },
        {
          "name": "keyword.operator.comparison.modelica",
          "match": "<=|>=|==|<>|<|>"
        },
        {
          "name": "keyword.operator.range.modelica",
          "match": ":"
        }
      ]
    }
  }
}
